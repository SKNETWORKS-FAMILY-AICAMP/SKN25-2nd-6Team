FROM node:20-alpine AS builder

ARG VITE_API_BASE_URL=http://localhost:8000
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

WORKDIR /frontend/vet-web

COPY frontend/vet-web/package*.json ./
RUN npm ci --prefer-offline

# shared assets는 ../../../../shared 경로로 참조되므로 구조 보존
COPY frontend/shared/ ../shared/
COPY frontend/vet-web/ ./
RUN npm run build

# ── production stage ──
FROM nginx:alpine

COPY --from=builder /frontend/vet-web/dist /usr/share/nginx/html
COPY ai/docker/nginx-vet.conf /etc/nginx/conf.d/default.conf

EXPOSE 5174

CMD ["nginx", "-g", "daemon off;"]
