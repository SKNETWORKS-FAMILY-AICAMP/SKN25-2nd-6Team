# MediPaw 환경변수 템플릿
# 이 파일을 복사해서 .env 로 만들고 값을 채우세요
# cp .env.example .env

# PostgreSQL
POSTGRES_PASSWORD=medipaw_secret

# JWT (랜덤 문자열 사용 권장)
SECRET_KEY=change-me-in-production

# AWS S3 + CloudFront (미사용 시 빈값 유지)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=medipaw-bucket
CLOUDFRONT_URL=

# OpenAI (필수)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

# 서버 설정
DEBUG=false
